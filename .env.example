# ==========================================
# AI News Agent & Telegram Bot Configuration
# ==========================================

# 1. Telegram Bot Credentials
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token_here"

# Your personal chat ID or channel ID where newsletters should be sent.
# (You can get your chat ID by messaging @userinfobot or @raw_data_bot on Telegram)
TELEGRAM_CHAT_ID="your_telegram_chat_id_here"

# 2. Automated Daily Schedule
# Delivery time in 24-hr format (HH:MM)
DAILY_DIGEST_TIME="09:00"

# Timezone (e.g. Asia/Kolkata, America/New_York, UTC, Europe/London)
TIMEZONE="Asia/Kolkata"

# 3. LLM Provider Configuration
# Supported providers: "gemini", "groq", "openai", "ollama", "auto"
LLM_PROVIDER="auto"

# Model name (e.g. "gemini-2.5-flash", "gpt-4o-mini", "llama-3.3-70b-versatile")
LLM_MODEL="gemini-2.5-flash"

# Provide at least one API key below:
GEMINI_API_KEY=""
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Optional custom base URL (for Ollama or LocalAI: http://localhost:11434/v1)
LLM_BASE_URL=""

# 4. MCP Server Client Mode
# "direct" (in-process, fastest) or "stdio" (MCP subprocess JSON-RPC protocol)
MCP_CLIENT_MODE="direct"
